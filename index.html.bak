    /*************************************************************************
     * 3. HỆ THỐNG TRỢ NĂNG NVDA & ĐỌC MÀN HÌNH (ARIA LIVE + OPTIONAL TTS)
     *************************************************************************/
    function announceNVDA(message, priority = 'polite') {
      if (!message) return;

      const visibleEl = document.getElementById('visible-live-status');
      if (visibleEl) {
        visibleEl.textContent = message;
      }

      state.liveToggleBuffer = !state.liveToggleBuffer;
      const suffix = state.liveToggleBuffer ? 'a' : 'b';
      const otherSuffix = state.liveToggleBuffer ? 'b' : 'a';

      const targetId = priority === 'assertive'
        ? `nvda-live-assertive-${suffix}`
        : `nvda-live-polite-${suffix}`;
      const clearId = priority === 'assertive'
        ? `nvda-live-assertive-${otherSuffix}`
        : `nvda-live-polite-${otherSuffix}`;

      const targetEl = document.getElementById(targetId);
      const clearEl = document.getElementById(clearId);

      if (clearEl) clearEl.textContent = '';
      if (targetEl) {
        targetEl.textContent = '';
        setTimeout(() => {
          targetEl.textContent = message;
        }, 25);
      }

      const logList = document.getElementById('nvda-history-log');
      if (logList) {
        const li = document.createElement('li');
        const now = new Date();
        const timeStr = now.toTimeString().slice(0, 8);
        li.className = 'py-1 border-b border-stone-200/70 last:border-none';
        li.textContent = `[${timeStr}] ${message}`;
        logList.prepend(li);
        while (logList.children.length > 25) {
          logList.removeChild(logList.lastChild);
        }
      }

      if (state.ttsEnabled && 'speechSynthesis' in window) {
        try {
          window.speechSynthesis.cancel();
          const utter = new SpeechSynthesisUtterance(message);
          utter.lang = 'vi-VN';
          utter.rate = 1.08;
          window.speechSynthesis.speak(utter);
        } catch (err) {
          // Ignore TTS errors
        }
      }
    }

    /*************************************************************************
     * 4. BỘ TỔNG HỢP ÂM THANH BẾP ĐA TẦNG (WEB AUDIO API PROCEDURAL FOLEY)
     *************************************************************************/
    let audioCtx = null;

    function ensureAudioContext() {
      if (!state.sfxEnabled) return null;
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioCtx = new AudioContextClass();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playSoundEffect(type) {
      const ctx = ensureAudioContext();
      if (!ctx) return;
      const now = ctx.currentTime;

      if (type === 'pick') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(320, now);
        osc.frequency.exponentialRampToValueAtTime(640, now + 0.09);
        gain.gain.setValueAtTime(0.18, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.1);
      } else if (type === 'chop') {
        [0, 0.14, 0.28].forEach((offset) => {
          const t = now + offset;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(190, t);
          osc.frequency.exponentialRampToValueAtTime(55, t + 0.07);
          gain.gain.setValueAtTime(0.32, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.08);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(t);
          osc.stop(t + 0.085);

          const bufSize = Math.floor(ctx.sampleRate * 0.05);
          const buffer = ctx.createBuffer(1, bufSize, ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufSize; i++) {
            data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufSize * 0.4));
          }
          const noise = ctx.createBufferSource();
          noise.buffer = buffer;
          const filter = ctx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.value = 1800;
          const nGain = ctx.createGain();
          nGain.gain.setValueAtTime(0.22, t);
          nGain.gain.exponentialRampToValueAtTime(0.001, t + 0.05);
          noise.connect(filter);
          filter.connect(nGain);
          nGain.connect(ctx.destination);
          noise.start(t);
        });
      } else if (type === 'sizzle' || type === 'deep_fry' || type === 'grill') {
        const duration = 0.65;
        const bufSize = Math.floor(ctx.sampleRate * duration);
        const buffer = ctx.createBuffer(1, bufSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufSize; i++) {
          const mod = 0.6 + 0.4 * Math.sin(i * 0.03);
          data[i] = (Math.random() * 2 - 1) * mod;
        }
        const noise = ctx.createBufferSource();
        noise.buffer = buffer;
        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(type === 'deep_fry' ? 2800 : 1900, now);
        filter.Q.value = 1.2;

        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.01, now);
        gain.gain.linearRampToValueAtTime(0.26, now + 0.08);
        gain.gain.exponentialRampToValueAtTime(0.005, now + duration);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        noise.start(now);
      } else if (type === 'boil') {
        [0, 0.11, 0.23, 0.36, 0.48].forEach((offset) => {
          const t = now + offset;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          const baseFreq = 220 + Math.random() * 180;
          osc.type = 'sine';
          osc.frequency.setValueAtTime(baseFreq, t);
          osc.frequency.exponentialRampToValueAtTime(baseFreq * 2.1, t + 0.08);
          gain.gain.setValueAtTime(0.16, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.09);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(t);
          osc.stop(t + 0.095);
        });
      } else if (type === 'oven') {
        const osc = ctx.createOscillator();
        const osc2 = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc2.type = 'triangle';
        osc.frequency.setValueAtTime(1046.5, now);
        osc2.frequency.setValueAtTime(1567.98, now);
        gain.gain.setValueAtTime(0.24, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.65);
        osc.connect(gain);
        osc2.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc2.start(now);
        osc.stop(now + 0.66);
        osc2.stop(now + 0.66);
      } else if (type === 'blend') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(95, now);
        osc.frequency.linearRampToValueAtTime(280, now + 0.35);
        osc.frequency.linearRampToValueAtTime(140, now + 0.6);

        const filter = ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 700;

        gain.gain.setValueAtTime(0.18, now);
        gain.gain.exponentialRampToValueAtTime(0.005, now + 0.62);
        osc.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.63);
      } else if (type === 'roll' || type === 'stuff') {
        const dur = 0.28;
        const bufSize = Math.floor(ctx.sampleRate * dur);
        const buffer = ctx.createBuffer(1, bufSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufSize; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.sin((i / bufSize) * Math.PI);
        }
        const noise = ctx.createBufferSource();
        noise.buffer = buffer;
        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.value = type === 'stuff' ? 1200 : 2200;
        const nGain = ctx.createGain();
        nGain.gain.value = 0.25;
        noise.connect(filter);
        filter.connect(nGain);
        nGain.connect(ctx.destination);
        noise.start(now);

        [523.25, 659.25, 783.99].forEach((freq, idx) => {
          const t = now + 0.12 + idx * 0.08;
          const osc = ctx.createOscillator();
          const g = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, t);
          g.gain.setValueAtTime(0.18, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.16);
          osc.connect(g);
          g.connect(ctx.destination);
          osc.start(t);
          osc.stop(t + 0.17);
        });
      } else if (type === 'spice_powder' || type === 'spice_liquid') {
        if (type === 'spice_powder') {
          [0, 0.1].forEach((offset) => {
            const t = now + offset;
            const bufSize = Math.floor(ctx.sampleRate * 0.06);
            const buffer = ctx.createBuffer(1, bufSize, ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;
            const noise = ctx.createBufferSource();
            noise.buffer = buffer;
            const filter = ctx.createBiquadFilter();
            filter.type = 'highpass';
            filter.frequency.value = 3200;
            const g = ctx.createGain();
            g.gain.setValueAtTime(0.2, t);
            g.gain.exponentialRampToValueAtTime(0.001, t + 0.06);
            noise.connect(filter);
            filter.connect(g);
            g.connect(ctx.destination);
            noise.start(t);
          });
        } else {
          [0, 0.11].forEach((offset, idx) => {
            const t = now + offset;
            const osc = ctx.createOscillator();
            const g = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(380 + idx * 90, t);
            osc.frequency.exponentialRampToValueAtTime(720 + idx * 90, t + 0.08);
            g.gain.setValueAtTime(0.2, t);
            g.gain.exponentialRampToValueAtTime(0.001, t + 0.09);
            osc.connect(g);
            g.connect(ctx.destination);
            osc.start(t);
            osc.stop(t + 0.095);
          });
        }
      } else if (type === 'drink') {
        [0, 0.14, 0.28].forEach((offset, idx) => {
          const t = now + offset;
          const osc = ctx.createOscillator();
          const g = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(280 + idx * 60, t);
          osc.frequency.exponentialRampToValueAtTime(520 + idx * 60, t + 0.1);
          g.gain.setValueAtTime(0.2, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.11);
          osc.connect(g);
          g.connect(ctx.destination);
          osc.start(t);
          osc.stop(t + 0.12);
        });
      } else if (type === 'react_love') {
        [523.25, 659.25, 783.99, 1046.5].forEach((freq, idx) => {
          const t = now + idx * 0.09;
          const osc = ctx.createOscillator();
          const g = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, t);
          g.gain.setValueAtTime(0.22, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.28);
          osc.connect(g);
          g.connect(ctx.destination);
          osc.start(t);
          osc.stop(t + 0.29);
        });
      } else if (type === 'react_good') {
        [440, 554.37, 659.25].forEach((freq, idx) => {
          const t = now + idx * 0.1;
          const osc = ctx.createOscillator();
          const g = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, t);
          g.gain.setValueAtTime(0.2, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.22);
          osc.connect(g);
          g.connect(ctx.destination);
          osc.start(t);
          osc.stop(t + 0.23);
        });
      } else if (type === 'react_spicy' || type === 'react_sour' || type === 'react_yuck') {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = type === 'react_spicy' ? 'sawtooth' : 'sine';
        osc.frequency.setValueAtTime(520, now);
        osc.frequency.exponentialRampToValueAtTime(130, now + 0.45);
        g.gain.setValueAtTime(0.22, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + 0.48);
        osc.connect(g);
        g.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.49);
      }
    }

    /*************************************************************************
     * 5. ENGINE HÒA VỊ THỰC TẾ (REAL-LIFE CULINARY CHEMISTRY ENGINE)
     *************************************************************************/
    function createFoodItemFromIngredient(ing) {
      return {
        uid: state.nextItemUid++,
        kind: 'single',
        baseId: ing.id,
        name: ing.name,
        emoji: ing.displayEmoji || ing.emoji,
        category: ing.category,
        color: ing.color,
        cookedColor: ing.cookedColor,
        needsCooking: ing.needsCooking,
        isFreshBalancer: !!ing.isFreshBalancer,
        cutState: 'whole',
        cookLevel: 0,
        cookMethod: 'none',
        spicesApplied: [],
        subItems: [],
        wrapperOrVessel: null,
        flavors: { ...ing.flavors }
      };
    }

    function describeItemStateShort(item) {
      const parts = [];
      if (item.kind === 'rolled' && item.wrapperOrVessel) {
        parts.push(`Cuốn trong ${item.wrapperOrVessel.name}`);
      } else if (item.kind === 'stuffed' && item.wrapperOrVessel) {
        parts.push(`Nhồi trong ${item.wrapperOrVessel.name}`);
      } else {
        if (item.cutState === 'sliced') parts.push('thái lát');
        else if (item.cutState === 'diced') parts.push('thái hạt lựu');
        else if (item.cutState === 'minced') parts.push('băm nhuyễn');
      }

      const methodLabels = {
        fried: 'áp chảo/xào',
        boiled: 'luộc/hầm',
        deep_fried: 'chiên ngập dầu',
        baked: 'đút lò nướng',
        grilled: 'nướng than hoa',
        blended: 'xay nhuyễn'
      };

      if (item.cookMethod === 'blended') {
        parts.push('xay sánh mịn');
      } else if (item.cookLevel === 0) {
        parts.push(item.needsCooking ? 'còn sống' : 'tươi');
      } else if (item.cookLevel === 1) {
        parts.push(`chín tới (${methodLabels[item.cookMethod] || 'đã nấu'})`);
      } else if (item.cookLevel === 2) {
        parts.push(`chín vàng giòn thơm (${methodLabels[item.cookMethod] || 'đã nấu'})`);
      } else if (item.cookLevel >= 3) {
        parts.push('cháy khét đen');
      }

      if (item.spicesApplied.length > 0) {
        const counts = {};
        item.spicesApplied.forEach(s => {
          counts[s.name] = (counts[s.name] || 0) + 1;
        });
        const spiceStr = Object.entries(counts)
          .map(([n, c]) => (c > 1 ? `${n} x${c}` : n))
          .join(', ');
        parts.push(`nêm: ${spiceStr}`);
      }

      return parts.join(', ');
    }

    function analyzeCulinaryChemistry(items) {
      const totals = {
        umami: 0,
        salty: 0,
        sweet: 0,
        sour: 0,
        spicy: 0,
        fatty: 0,
        bitter: 0,
        aroma: 0,
        crunch: 0
      };

      if (!items || items.length === 0) {
        return {
          totals,
          normalized: { ...totals },
          synergies: [],
          warnings: [],
          dishTitle: 'Đĩa đang trống (Hãy chọn nguyên liệu từ tủ)',
          structureSummary: 'Chưa có thành phần nào.',
          harmonyScore: 0,
          hasRawMeatOrSeafood: false,
          hasBurntItem: false,
          hasFreshBalancer: false,
          allStructures: []
        };
      }

      let hasRawMeatOrSeafood = false;
      let hasBurntItem = false;
      let hasFreshBalancer = false;
      let marinationCount = 0;
      let hasBoiledSoup = false;
      const allStructures = new Set();
      const allSpiceIds = new Set();

      function accumulateItem(it, weight = 1.0) {
        if (it.kind === 'rolled') allStructures.add('rolled');
        else if (it.kind === 'stuffed') allStructures.add('stuffed');
        else if (it.kind === 'blended') allStructures.add('blended');
        else allStructures.add('loose');

        if (it.isFreshBalancer && it.cookLevel <= 1) {
          hasFreshBalancer = true;
        }
        if (it.cookMethod === 'boiled' && it.cookLevel >= 1) {
          hasBoiledSoup = true;
        }
        if (it.cookLevel >= 3) {
          hasBurntItem = true;
        }

        if (it.needsCooking && it.cookLevel === 0) {
          hasRawMeatOrSeafood = true;
        }

        Object.keys(totals).forEach(k => {
          totals[k] += (it.flavors[k] || 0) * weight;
        });

        it.spicesApplied.forEach(sp => {
          allSpiceIds.add(sp.id);
          if (sp.cookedIn) marinationCount++;
        });

        if (it.subItems && it.subItems.length > 0) {
          it.subItems.forEach(sub => {
            if (sub.needsCooking && sub.cookLevel === 0 && it.cookLevel === 0) {
              hasRawMeatOrSeafood = true;
            }
            if (sub.isFreshBalancer) hasFreshBalancer = true;
            sub.spicesApplied.forEach(sp => {
              allSpiceIds.add(sp.id);
              if (sp.cookedIn) marinationCount++;
            });
          });
        }
      }

      items.forEach(it => accumulateItem(it, 1.0));

      const countFactor = Math.max(1, Math.sqrt(items.length) * 0.88);
      const blended = {};
      Object.keys(totals).forEach(k => {
        blended[k] = Math.max(0, totals[k] / countFactor);
      });

      const synergies = [];
      const warnings = [];

      // 1. Sweet + Sour Harmony
      if (blended.sour >= 1.4 && blended.sweet >= 1.4) {
        blended.sour *= 0.82;
        blended.sweet *= 0.88;
        blended.aroma += 1.2;
        synergies.push('🍋🍬 Hòa vị Chua Ngọt Thanh Mát (Chua và Ngọt làm dịu độ gắt của nhau)');
      }

      // 2. Salt unlocks Umami & Natural Sweetness
      if (blended.salty >= 1.0 && blended.salty <= 4.8 && blended.umami >= 1.5) {
        blended.umami *= 1.22;
        blended.sweet += 0.4;
        synergies.push('🧂🥩 Muối/Mắm Tôn Vị Ngọt Đạm (Kích hoạt vị ngọt thịt tự nhiên)');
      }

      // 3. Signature Vietnamese 5-Flavor Dipping/Seasoning Harmony
      if (
        blended.salty >= 1.2 &&
        blended.sweet >= 1.2 &&
        blended.sour >= 1.0 &&
        blended.spicy >= 0.8 &&
        blended.umami >= 1.8
      ) {
        blended.aroma += 1.6;
        synergies.push('🌟 Ngũ Vị Hòa Quyện Đỉnh Cao (Mặn - Ngọt - Chua - Cay - Đậm đà cân bằng hoàn hảo)');
      }

      // 4. Acid + Fresh Herbs/Pickles cut Fatty Richness
      if (blended.fatty >= 2.5 && (blended.sour >= 1.2 || hasFreshBalancer)) {
        blended.fatty *= 0.68;
        blended.aroma += 1.0;
        synergies.push('🥒🍋 Rau Tươi & Vị Chua Cắt Độ Ngấy Béo (Giúp món thịt/đồ chiên thanh thoát, không ngấy mỡ)');
      } else if (blended.fatty >= 4.5 && blended.sour < 0.8 && !hasFreshBalancer) {
        warnings.push('⚠️ Món ăn đang khá béo ngậy, dễ ngấy (Gợi ý: vắt thêm Chanh, thêm Dưa leo, Đồ chua hoặc Rau thơm)');
      }

      // 5. Fat/Dairy tames extreme Spice
      if (blended.spicy >= 3.2 && blended.fatty >= 2.0) {
        blended.spicy *= 0.78;
        synergies.push('🧈🌶️ Vị Béo Làm Dịu Độ Cay Gắt (Chuyển thành vị cay béo ấm nồng dễ chịu)');
      }

      // 6. Marination before Cooking
      if (marinationCount > 0) {
        blended.aroma += Math.min(2.2, marinationCount * 0.65);
        blended.umami += Math.min(1.5, marinationCount * 0.4);
        synergies.push('🔥🧄 Gia Vị Ướp Thấm Sâu Khi Nấu (Dậy hương thơm gấp đôi nhờ phản ứng nhiệt)');
      }

      // 7. Boiling Broth Harmony
      if (hasBoiledSoup && items.length >= 2) {
        blended.salty *= 0.88;
        blended.umami += 0.9;
        synergies.push('🍲 Nước Dùng Hòa Quyện (Các nguyên liệu luộc/hầm tiết vị ngọt thanh vào nhau)');
      }

      // 8. Structural Synergies
      if (allStructures.has('rolled')) {
        synergies.push('🌯 Kết Cấu Món Cuốn Đa Tầng (Vỏ cuốn ôm trọn nhân và gia vị trong từng miếng cắn)');
      }
      if (allStructures.has('stuffed')) {
        synergies.push('🥖 Kết Cấu Bánh Kẹp Nhồi Nhân (Vỏ bánh ngoài kết hợp nhân đậm đà bên trong)');
      }

      if (hasRawMeatOrSeafood) {
        warnings.push('🤢 Có thịt/hải sản/trứng sống chưa nấu chín! Thực khách sẽ thấy tanh và đau bụng.');
      }
      if (hasBurntItem) {
        blended.bitter += 4.5;
        warnings.push('炭 Có nguyên liệu bị nấu quá lửa cháy khét đen, gây vị đắng khét!');
      }
      if (blended.salty > 5.6) {
        warnings.push('🧂 Món ăn đang bị MẶN CHÁT vì nêm quá nhiều muối/nước mắm (Hãy thêm đường, chanh hoặc tinh bột/rau để trung hòa).');
      }
      if (blended.spicy > 6.0) {
        warnings.push('🌶️ Món ăn CỰC KỲ CAY (Chỉ những thực khách mê ăn cay như Rồng Lửa mới chịu nổi!).');
      }
      if (blended.sour > 5.5) {
        warnings.push('🍋 Món ăn đang CHUA GẮT ê răng (Có thể thêm Đường hoặc Mật ong để dịu thành vị chua ngọt).');
      }

      const normalized = {};
      Object.keys(blended).forEach(k => {
        normalized[k] = Math.min(10, Math.max(0, Number(blended[k].toFixed(1))));
      });

      let score = 58;
      score += Math.min(22, normalized.umami * 2.8);
      score += Math.min(18, normalized.aroma * 2.4);
      score += synergies.length * 7;

      if (normalized.salty > 5.6) score -= (normalized.salty - 5.6) * 10;
      if (normalized.sour > 5.5) score -= (normalized.sour - 5.5) * 8;
      if (normalized.bitter > 2.2) score -= (normalized.bitter - 2.2) * 11;
      if (hasRawMeatOrSeafood) score -= 38;
      if (hasBurntItem) score -= 35;

      score = Math.max(5, Math.min(100, Math.round(score)));

      const dishTitle = buildDynamicDishTitle(items, normalized);
      const structureSummary = items.map(it => `${it.name} (${describeItemStateShort(it)})`).join(' + ');

      return {
        totals,
        normalized,
        synergies,
        warnings,
        dishTitle,
        structureSummary,
        harmonyScore: score,
        hasRawMeatOrSeafood,
        hasBurntItem,
        hasFreshBalancer,
        allStructures: Array.from(allStructures)
      };
    }

    function buildDynamicDishTitle(items, normFlavors) {
      if (!items || items.length === 0) return 'Đĩa đang trống';

      const rolledItem = items.find(i => i.kind === 'rolled');
      const stuffedItem = items.find(i => i.kind === 'stuffed');
      const blendedItem = items.find(i => i.kind === 'blended');

      let flavorSuffix = '';
      if (normFlavors.sour >= 1.5 && normFlavors.sweet >= 1.5 && normFlavors.spicy >= 1.2) {
        flavorSuffix = ' Vị Chua Cay Mặn Ngọt';
      } else if (normFlavors.sour >= 1.5 && normFlavors.sweet >= 1.5) {
        flavorSuffix = ' Chua Ngọt Thanh Mát';
      } else if (normFlavors.spicy >= 2.2 && normFlavors.salty >= 1.2) {
        flavorSuffix = ' Cay Nồng Đậm Đà';
      } else if (normFlavors.fatty >= 2.5 && normFlavors.aroma >= 2.0) {
        flavorSuffix = ' Béo Thơm Ngậy';
      } else if (normFlavors.umami >= 2.5) {
        flavorSuffix = ' Đậm Vị Ngọt Thịt';
      }

      if (rolledItem && items.length === 1) {
        return `${rolledItem.name}${flavorSuffix}`;
      }
      if (stuffedItem && items.length === 1) {
        return `${stuffedItem.name}${flavorSuffix}`;
      }
      if (blendedItem && items.length === 1) {
        return `${blendedItem.name}${flavorSuffix}`;
      }

      const mainNames = items.slice(0, 3).map(i => i.name).join(' & ');
      const extraCount = items.length > 3 ? ` (+${items.length - 3} món)` : '';
      return `${mainNames}${extraCount}${flavorSuffix}`;
    }

    /*************************************************************************
     * 6. THAO TÁC CHẾ BIẾN, CUỐN, NHỒI, NÊM GIA VỊ & ĐÚT ĂN
     *************************************************************************/

    function addIngredientFromPantry(ingId) {
      const ing = INGREDIENTS.find(i => i.id === ingId);
      if (!ing) return;

      const newItem = createFoodItemFromIngredient(ing);
      playSoundEffect('pick');

      if (state.ingredientDestination === 'plate') {
        state.plateItems.push(newItem);
        announceNVDA(
          `Đã lấy ${ing.name} (${ing.flavorDesc}) bỏ thẳng lên Đĩa Ăn. Trên đĩa hiện có ${state.plateItems.length} thành phần.`,
          'polite'
        );
      } else {
        const station = STATIONS.find(s => s.id === state.activeStationId);
        state.stationItems.push(newItem);
        announceNVDA(
          `Đã bỏ ${ing.name} (${ing.flavorDesc}) vào ${station.name}. Trong dụng cụ hiện có ${state.stationItems.length} nguyên liệu.`,
          'polite'
        );
      }
      renderAll();
    }

    function applySpice(spiceId) {
      const spice = SPICES.find(s => s.id === spiceId);
      if (!spice) return;

      const targetArray = state.spiceTarget === 'plate' ? state.plateItems : state.stationItems;
      const targetName = state.spiceTarget === 'plate'
        ? 'Đĩa Thức Ăn'
        : STATIONS.find(s => s.id === state.activeStationId).name;

      if (targetArray.length === 0) {
        announceNVDA(
          `Chưa có thức ăn nào trong ${targetName} để nêm ${spice.name}! Hãy lấy nguyên liệu trước.`,
          'assertive'
        );
        return;
      }

      playSoundEffect(spice.type === 'powder' ? 'spice_powder' : 'spice_liquid');

      const share = 1 / Math.sqrt(targetArray.length);
      targetArray.forEach(item => {
        item.spicesApplied.push({ id: spice.id, name: spice.name, cookedIn: false });
        Object.keys(spice.add).forEach(k => {
          item.flavors[k] = Math.max(0, (item.flavors[k] || 0) + spice.add[k] * share);
        });
      });

      state.stationActionFlash = 18;
      state.stationActionType = 'spice';

      const analysis = analyzeCulinaryChemistry(targetArray);
      const topSynergy = analysis.synergies.length > 0
        ? ` Hòa vị: ${analysis.synergies[0].replace(/^[^\s]+\s/, '')}.`
        : '';

      announceNVDA(
        `Đã nêm ${spice.name} (${spice.desc}) vào ${targetName}.${topSynergy}`,
        'polite'
      );
      renderAll();
    }

    function performStationAction(actionId) {
      const station = STATIONS.find(s => s.id === state.activeStationId);
      if (!station) return;

      if (state.stationItems.length === 0) {
        announceNVDA(
          `${station.name} đang trống! Hãy chọn nguyên liệu ở Tủ Nguyên Liệu (Alt+2) bỏ vào dụng cụ trước.`,
          'assertive'
        );
        return;
      }

      state.stationActionFlash = 26;
      state.stationActionType = actionId;

      if (actionId === 'slice' || actionId === 'dice' || actionId === 'mince') {
        playSoundEffect('chop');
        const labelMap = {
          slice: 'thái lát mỏng',
          dice: 'thái hạt lựu vuông vức',
          mince: 'băm nhuyễn'
        };
        state.stationItems.forEach(item => {
          item.cutState = actionId === 'slice' ? 'sliced' : actionId === 'dice' ? 'diced' : 'minced';
          item.flavors.aroma += 0.45;
          item.flavors.umami += 0.2;
        });
        const names = state.stationItems.map(i => i.name).join(', ');
        announceNVDA(
          `Đã dùng dao ${labelMap[actionId]} ${names} trên thớt gỗ. Nguyên liệu dậy mùi thơm và sẵn sàng để cuốn, nhồi hoặc nấu!`,
          'polite'
        );
        renderAll();
        return;
      }

      if (actionId === 'roll_tight') {
        const wrapper = WRAPPERS.find(w => w.id === state.selectedWrapperId) || WRAPPERS[0];
        playSoundEffect('roll');

        const innerNames = state.stationItems.map(i => i.name);
        const combinedFlavors = { ...wrapper.flavors };
        const combinedSpices = [];
        let anyNeedsCooking = false;
        let maxCookLevel = 0;

        state.stationItems.forEach(item => {
          Object.keys(combinedFlavors).forEach(k => {
            combinedFlavors[k] = (combinedFlavors[k] || 0) + (item.flavors[k] || 0) * 0.85;
          });
          if (item.needsCooking && item.cookLevel === 0) {
            anyNeedsCooking = true;
          }
          if (item.cookLevel > maxCookLevel) maxCookLevel = item.cookLevel;
          item.spicesApplied.forEach(sp => combinedSpices.push({ ...sp }));
        });

        combinedFlavors.aroma += 1.4;
        combinedFlavors.umami += 0.8;

        const shortInner = innerNames.slice(0, 3).join(', ') + (innerNames.length > 3 ? ` và ${innerNames.length - 3} nguyên liệu khác` : '');
        const rolledItem = {
          uid: state.nextItemUid++,
          kind: 'rolled',
          baseId: `roll_${wrapper.id}`,
          name: `${wrapper.dishPrefix} (${shortInner})`,
          emoji: '🌯',
          category: 'composite',
          color: wrapper.color,
          cookedColor: '#d97706',
          needsCooking: anyNeedsCooking,
          isFreshBalancer: state.stationItems.some(i => i.isFreshBalancer),
          cutState: 'whole',
          cookLevel: anyNeedsCooking ? 0 : Math.max(1, maxCookLevel),
          cookMethod: 'none',
          spicesApplied: combinedSpices,
          subItems: [...state.stationItems],
          wrapperOrVessel: wrapper,
          flavors: combinedFlavors
        };

        state.stationItems = [rolledItem];
        announceNVDA(
          `Đã trải ${wrapper.name} và cuộn tròn một lượt ${innerNames.join(', ')} thành món "${rolledItem.name}"! Bạn có thể bấm Phím P để bày ra đĩa ăn ngay, hoặc chuyển cuốn này sang Chảo Chiên / Vỉ Nướng để làm Nem rán hoặc Bò nướng lá lốt!`,
          'assertive'
        );
        renderAll();
        return;
      }

      if (actionId === 'stuff_pack') {
        const vessel = VESSELS.find(v => v.id === state.selectedVesselId) || VESSELS[0];
        playSoundEffect('stuff');

        const innerNames = state.stationItems.map(i => i.name);
        const combinedFlavors = { ...vessel.flavors };
        const combinedSpices = [];
        let anyNeedsCooking = false;

        state.stationItems.forEach(item => {
          Object.keys(combinedFlavors).forEach(k => {
            combinedFlavors[k] = (combinedFlavors[k] || 0) + (item.flavors[k] || 0) * 0.85;
          });
          if (item.needsCooking && item.cookLevel === 0) {
            anyNeedsCooking = true;
          }
          item.spicesApplied.forEach(sp => combinedSpices.push({ ...sp }));
        });

        combinedFlavors.aroma += 1.6;
        combinedFlavors.crunch += vessel.flavors.crunch * 0.5;

        const shortInner = innerNames.slice(0, 3).join(', ') + (innerNames.length > 3 ? ` + ${innerNames.length - 3} nhân khác` : '');
        const stuffedItem = {
          uid: state.nextItemUid++,
          kind: 'stuffed',
          baseId: `stuffed_${vessel.id}`,
          name: `${vessel.dishPrefix}: ${shortInner}`,
          emoji: vessel.emoji,
          category: 'composite',
          color: vessel.color,
          cookedColor: '#b45309',
          needsCooking: anyNeedsCooking,
          isFreshBalancer: state.stationItems.some(i => i.isFreshBalancer),
          cutState: 'whole',
          cookLevel: anyNeedsCooking ? 0 : 1,
          cookMethod: 'none',
          spicesApplied: combinedSpices,
          subItems: [...state.stationItems],
          wrapperOrVessel: vessel,
          flavors: combinedFlavors
        };

        state.stationItems = [stuffedItem];
        announceNVDA(
          `Đã xẻ ${vessel.name}, nhồi đầy ${innerNames.join(', ')} vào ruột và kẹp chặt thành món "${stuffedItem.name}"! Bấm Phím P để cho ra đĩa thưởng thức hoặc đem bỏ Lò Nướng cho nóng giòn!`,
          'assertive'
        );
        renderAll();
        return;
      }

      if (actionId === 'blend_smooth') {
        playSoundEffect('blend');
        const innerNames = state.stationItems.map(i => i.name);
        const combinedFlavors = {
          umami: 0, salty: 0, sweet: 0, sour: 0, spicy: 0, fatty: 0, bitter: 0, aroma: 0.8, crunch: 0
        };
        const combinedSpices = [];
        let anyRawMeat = false;

        state.stationItems.forEach(item => {
          Object.keys(combinedFlavors).forEach(k => {
            if (k !== 'crunch') {
              combinedFlavors[k] += (item.flavors[k] || 0) * 0.85;
            }
          });
          if (item.needsCooking && item.cookLevel === 0) anyRawMeat = true;
          item.spicesApplied.forEach(sp => combinedSpices.push({ ...sp }));
        });

        const isFruitSmoothie = state.stationItems.every(i => i.category === 'fruit' || i.id === 'avocado');
        const prefix = isFruitSmoothie ? 'Ly Sinh Tố' : 'Hỗn Hợp Xay Sánh Mịn';
        const shortInner = innerNames.slice(0, 3).join(', ');

        const blendedItem = {
          uid: state.nextItemUid++,
          kind: 'blended',
          baseId: 'blended_mix',
          name: `${prefix} (${shortInner})`,
          emoji: isFruitSmoothie ? '🥤' : '🥣',
          category: 'composite',
          color: state.stationItems[0].color,
          cookedColor: state.stationItems[0].cookedColor,
          needsCooking: anyRawMeat,
          isFreshBalancer: state.stationItems.some(i => i.isFreshBalancer),
          cutState: 'minced',
          cookLevel: anyRawMeat ? 0 : 1,
          cookMethod: 'blended',
          spicesApplied: combinedSpices,
          subItems: [...state.stationItems],
          wrapperOrVessel: null,
          flavors: combinedFlavors
        };

        state.stationItems = [blendedItem];
        announceNVDA(
          `Máy xay đã xay nhuyễn ${innerNames.join(', ')} thành "${blendedItem.name}" sánh mịn, các hương vị hòa tan hoàn toàn vào nhau!`,
          'polite'
        );
        renderAll();
        return;
      }

      const heatMap = {
        fry_step: { method: 'fried', sound: 'sizzle', verb: 'Áp chảo / Xào lửa vừa' },
        boil_step: { method: 'boiled', sound: 'boil', verb: 'Đun sôi / Luộc hầm' },
        deep_fry_step: { method: 'deep_fried', sound: 'deep_fry', verb: 'Chiên ngập dầu' },
        bake_step: { method: 'baked', sound: 'oven', verb: 'Nướng trong lò' },
        grill_step: { method: 'grilled', sound: 'grill', verb: 'Nướng trên than hoa' }
      };

      const heatInfo = heatMap[actionId];
      if (heatInfo) {
        playSoundEffect(heatInfo.sound);

        const statusDescriptions = [];
        state.stationItems.forEach(item => {
          item.cookLevel += 1;
          item.cookMethod = heatInfo.method;

          item.spicesApplied.forEach(sp => {
            sp.cookedIn = true;
          });

          if (item.subItems && item.subItems.length > 0) {
            item.subItems.forEach(sub => {
              sub.cookLevel = Math.max(sub.cookLevel, item.cookLevel);
              sub.cookMethod = heatInfo.method;
              sub.spicesApplied.forEach(sp => { sp.cookedIn = true; });
            });
          }

          if (item.cookLevel === 1) {
            item.needsCooking = false;
            item.flavors.umami += 0.9;
            item.flavors.aroma += 1.3;
            item.flavors.sweet += 0.35;
            if (heatInfo.method === 'deep_fried') {
              item.flavors.fatty += 1.5;
              item.flavors.crunch += 2.2;
            } else if (heatInfo.method === 'grilled') {
              item.flavors.aroma += 1.1;
            } else if (heatInfo.method === 'boiled') {
              item.flavors.fatty = Math.max(0, item.flavors.fatty - 0.4);
            }
            statusDescriptions.push(`${item.name} đã chín tới thơm ngon`);
          } else if (item.cookLevel === 2) {
            item.needsCooking = false;
            item.flavors.aroma += 1.4;
            item.flavors.umami += 0.6;
            item.flavors.crunch += 1.6;
            if (item.kind === 'rolled' && item.wrapperOrVessel && item.wrapperOrVessel.id === 'rice_paper' && heatInfo.method === 'deep_fried') {
              item.name = item.name.replace('Gỏi Cuốn Bánh Tráng', 'Chả Giò / Nem Rán Giòn Rụm');
            }
            if (item.kind === 'rolled' && item.wrapperOrVessel && item.wrapperOrVessel.id === 'betel_leaf') {
              item.name = item.name.replace('Cuốn Lá Lốt Thơm Lừng', 'Bò/Thịt Nướng Lá Lốt Chín Vàng');
            }
            statusDescriptions.push(`${item.name} đã chín vàng giòn rụm, dậy mùi thơm phức`);
          } else {
            item.flavors.bitter += 3.5;
            item.flavors.sweet = Math.max(0, item.flavors.sweet - 1.2);
            item.flavors.aroma = Math.max(0, item.flavors.aroma - 1.5);
            statusDescriptions.push(`CẢNH BÁO: ${item.name} đã bị nấu quá lâu nên CHÁY KHÉT ĐEN và đắng!`);
          }
        });

        announceNVDA(
          `${heatInfo.verb}: ${statusDescriptions.join('; ')}.`,
          state.stationItems.some(i => i.cookLevel >= 3) ? 'assertive' : 'polite'
        );
        renderAll();
      }
    }

    function moveStationToPlate() {
      if (state.stationItems.length === 0) {
        announceNVDA('Không có thức ăn nào trong dụng cụ để bày ra đĩa!', 'assertive');
        return;
      }
      playSoundEffect('pick');
      const count = state.stationItems.length;
      const movedNames = state.stationItems.map(i => i.name).join(', ');
      state.plateItems.push(...state.stationItems);
      state.stationItems = [];

      const analysis = analyzeCulinaryChemistry(state.plateItems);
      announceNVDA(
        `Đã bày ${count} phần (${movedNames}) ra Đĩa Ăn. Món trên đĩa hiện tại: "${analysis.dishTitle}". Độ hài hòa hương vị: ${analysis.harmonyScore} trên 100 điểm. Bấm Phím F để đút cho thực khách ăn!`,
        'polite'
      );
      renderAll();
    }

    function movePlateBackToStation() {
      if (state.plateItems.length === 0) {
        announceNVDA('Đĩa ăn đang trống, không có gì để đưa lại vào bếp!', 'assertive');
        return;
      }
      playSoundEffect('pick');
      const station = STATIONS.find(s => s.id === state.activeStationId);
      const movedNames = state.plateItems.map(i => i.name).join(', ');
      state.stationItems.push(...state.plateItems);
      state.plateItems = [];
      announceNVDA(
        `Đã chuyển ${movedNames} từ đĩa ăn quay lại ${station.name} để chế biến tiếp!`,
        'polite'
      );
      renderAll();
    }

    function feedCharacter() {
      let sourceItems = state.plateItems;
      let autoMoved = false;
      if (sourceItems.length === 0 && state.stationItems.length > 0) {
        state.plateItems.push(...state.stationItems);
        state.stationItems = [];
        sourceItems = state.plateItems;
        autoMoved = true;
      }

      const char = CHARACTERS.find(c => c.id === state.activeCharacterId) || CHARACTERS[0];

      if (sourceItems.length === 0) {
        announceNVDA(
          `Đĩa thức ăn và dụng cụ đều đang trống! Hãy chọn nguyên liệu (Alt+2), chế biến hoặc cuốn/nhồi (Alt+3) rồi đút cho ${char.name} ăn nhé.`,
          'assertive'
        );
        return;
      }

      const analysis = analyzeCulinaryChemistry(sourceItems);
      const f = analysis.normalized;

      let reactionType = 'good';
      let speech = '';
      let moodTag = '';
      let finalScore = analysis.harmonyScore;

      char.likes.forEach(likedKey => {
        if (f[likedKey] >= 2.0) finalScore += 5;
      });
      if (char.lovesStructures.some(st => analysis.allStructures.includes(st))) {
        finalScore += 8;
      }
      finalScore = Math.max(0, Math.min(100, finalScore));

      if (analysis.hasRawMeatOrSeafood) {
        reactionType = 'yuck';
        finalScore = Math.min(finalScore, 22);
        moodTag = 'Tanh & Sống quá! 🤢';
        speech = `"Ối giời ơi! Món ${analysis.dishTitle} còn thịt/hải sản SỐNG chưa nấu chín! Ăn vào vừa tanh vừa đau bụng mất thôi, đầu bếp nhớ chiên, luộc hoặc nướng chín trước nhé!"`;
        playSoundEffect('react_yuck');
      } else if (analysis.hasBurntItem) {
        reactionType = 'yuck';
        finalScore = Math.min(finalScore, 25);
        moodTag = 'Cháy khét lẹt! 炭';
        speech = `"Khụ khụ! Món ${analysis.dishTitle} bị nấu quá lửa cháy đen thui, đắng nghét mùi khói than rồi! Lần sau canh lửa vừa chín vàng thôi nha!"`;
        playSoundEffect('react_yuck');
      } else if (f.salty > 5.6) {
        reactionType = 'salty';
        finalScore = Math.min(finalScore, 38);
        moodTag = 'Mặn chát khát nước! 🧂💦';
        speech = `"Ái chà! Món ${analysis.dishTitle} nêm quá tay muối/mắm nên mặn chát cả lưỡi, cho tôi xin ly nước lọc gấp! Lần sau nhớ vắt thêm chanh, chút đường hoặc thêm rau/cơm để cân bằng vị mặn nhé!"`;
        playSoundEffect('react_sour');
      } else if (f.spicy > char.maxSpiceTolerance) {
        reactionType = 'spicy';
        finalScore = Math.min(finalScore, 48);
        moodTag = 'Cay xè phun lửa! 🔥🌶️';
        speech = `"Hààà! Cay xé lưỡi luôn! Món ${analysis.dishTitle} có độ cay ${f.spicy}/10 vượt quá sức chịu cay của tôi rồi! Nếu thêm chút bơ, sốt mayonnaise hoặc phô mai sẽ dịu độ cay lại ngay!"`;
        playSoundEffect('react_spicy');
      } else if (f.sour > 5.2 && f.sweet < 1.5) {
        reactionType = 'sour';
        finalScore = Math.min(finalScore, 45);
        moodTag = 'Chua nhăn mặt! 🍋😖';
        speech = `"Chu choa ơi nó chua ê cả răng! Món ${analysis.dishTitle} nhiều chanh/giấm quá mà thiếu vị ngọt đối trọng. Chỉ cần thêm chút đường hoặc mật ong là thành vị chua ngọt thanh mát liền!"`;
        playSoundEffect('react_sour');
      } else if (finalScore >= 80) {
        reactionType = 'love';
        moodTag = 'Tuyệt phẩm 5 Sao! 🤩🌟';
        const synergyNote = analysis.synergies.length > 0
          ? ` Đặc biệt: ${analysis.synergies.slice(0, 2).map(s => s.replace(/^[^\s]+\s/, '')).join(' và ')}.`
          : '';
        speech = `"Nhoàm nhoàm... TUYỆT CÚ MÈO! Món ${analysis.dishTitle} hòa vị như ngoài đời thực! Vị đậm đà (${f.umami}/10), hương thơm (${f.aroma}/10), mặn (${f.salty}/10), ngọt (${f.sweet}/10), chua (${f.sour}/10), cay (${f.spicy}/10) quyện vào nhau xuất sắc!${synergyNote}"`;
        playSoundEffect('react_love');
      } else {
        reactionType = 'good';
        moodTag = 'Ngon miệng! 😋👍';
        speech = `"Măm măm! Món ${analysis.dishTitle} ăn khá vừa miệng (Điểm hài hòa: ${finalScore}/100). Hương vị chính gồm Đậm đà ${f.umami}/10, Mặn ${f.salty}/10, Ngọt ${f.sweet}/10, Chua ${f.sour}/10, Cay ${f.spicy}/10. Nếu ướp thêm chút gia vị hoặc kết hợp rau thơm sẽ đạt điểm tuyệt đối!"`;
        playSoundEffect('react_good');
      }

      state.charAnimState = reactionType;
      state.charAnimTimer = 95;

      const moodEl = document.getElementById('char-mood-tag');
      const speechEl = document.getElementById('char-reaction-speech');
      const scoreEl = document.getElementById('char-last-score');

      if (moodEl) moodEl.textContent = moodTag;
      if (speechEl) speechEl.textContent = speech;
      if (scoreEl) scoreEl.textContent = `${finalScore} / 100 điểm (${moodTag})`;

      state.plateItems = [];

      const autoNote = autoMoved ? 'Đã tự động dọn thức ăn từ dụng cụ ra đĩa. ' : '';
      announceNVDA(
        `${autoNote}${char.name} vừa thưởng thức món "${analysis.dishTitle}". Biểu cảm: ${moodTag} (${finalScore} trên 100 điểm). Nhận xét: ${speech}`,
        'assertive'
      );

      renderAll();
    }

    function readCurrentDishAndFlavorReport() {
      const targetItems = state.plateItems.length > 0 ? state.plateItems : state.stationItems;
      const locationLabel = state.plateItems.length > 0
        ? 'trên Đĩa Ăn'
        : `trong dụng cụ ${STATIONS.find(s => s.id === state.activeStationId).name}`;

      if (targetItems.length === 0) {
        announceNVDA(
          'Hiện tại cả Đĩa Ăn và Dụng Cụ Chế Biến đều đang trống. Hãy bấm Alt+2 để chọn nguyên liệu từ tủ.',
          'assertive'
        );
        return;
      }

      const analysis = analyzeCulinaryChemistry(targetItems);
      const f = analysis.normalized;
      const synergyText = analysis.synergies.length > 0
        ? `Phản ứng hòa vị: ${analysis.synergies.map(s => s.replace(/^[^\s]+\s/, '')).join('; ')}. `
        : '';
      const warningText = analysis.warnings.length > 0
        ? `Lưu ý: ${analysis.warnings.map(w => w.replace(/^[^\s]+\s/, '')).join('; ')}. `
        : '';

      const report = `Báo cáo món ăn ${locationLabel}: Tên món "${analysis.dishTitle}". Thành phần: ${analysis.structureSummary}. Độ hài hòa: ${analysis.harmonyScore} trên 100 điểm. Chi tiết 8 vị: Đậm đà Umami ${f.umami}, Mặn ${f.salty}, Ngọt ${f.sweet}, Chua ${f.sour}, Cay ${f.spicy}, Béo ${f.fatty}, Hương thơm ${f.aroma}, Đắng khét ${f.bitter}. ${synergyText}${warningText}`;
      announceNVDA(report, 'assertive');
    }

    /*************************************************************************
     * 7. RENDER GIAO DIỆN DOM & CẬP NHẬT TRẠNG THÁI TRỢ NĂNG NVDA
     *************************************************************************/

    function renderCharacters() {
      const container = document.getElementById('character-buttons-container');
      if (!container) return;
      container.innerHTML = '';

      const activeChar = CHARACTERS.find(c => c.id === state.activeCharacterId) || CHARACTERS[0];

      CHARACTERS.forEach(c => {
        const isSelected = c.id === state.activeCharacterId;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'radio');
        btn.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        btn.setAttribute('aria-label', `${c.name} - ${c.title}. ${c.desc}`);
        btn.className = `p-2 rounded-xl border text-left transition flex flex-col items-center text-center gap-0.5 ${
          isSelected ? 'char-btn-active font-bold' : 'bg-stone-50 hover:bg-amber-50/50 border-stone-200 text-stone-700'
        }`;
        btn.innerHTML = `
          <span class="text-2xl leading-none" aria-hidden="true">${c.emoji}</span>
          <span class="text-[11px] font-bold leading-tight mt-1 line-clamp-1">${c.name}</span>
        `;
        btn.addEventListener('click', () => {
          state.activeCharacterId = c.id;
          state.charAnimState = 'idle';
          playSoundEffect('pick');
          announceNVDA(`Đã chọn thực khách: ${c.name} (${c.title}). Sở thích: ${c.desc}`, 'polite');
          renderAll();
        });
        container.appendChild(btn);
      });

      document.getElementById('active-char-badge').textContent = activeChar.name;
      document.getElementById('char-detail-name').textContent = `${activeChar.name} (${activeChar.title})`;
      document.getElementById('char-detail-pref').textContent = activeChar.desc;
      document.getElementById('feed-btn-label').textContent = `Đút Cho ${activeChar.name} Ăn! (Phím F)`;
    }

    function renderPantry() {
      const tabsContainer = document.getElementById('pantry-category-tabs');
      if (tabsContainer) {
        tabsContainer.innerHTML = '';
        PANTRY_CATEGORIES.forEach(cat => {
          const isActive = cat.id === state.activeCategoryId;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('role', 'tab');
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          btn.className = `px-2.5 py-1 rounded-lg text-xs font-bold transition ${
            isActive ? 'bg-amber-600 text-white shadow-sm' : 'bg-stone-100 hover:bg-stone-200 text-stone-700'
          }`;
          btn.textContent = cat.name;
          btn.addEventListener('click', () => {
            state.activeCategoryId = cat.id;
            announceNVDA(`Đã lọc danh mục nguyên liệu: ${cat.name}`, 'polite');
            renderPantry();
          });
          tabsContainer.appendChild(btn);
        });
      }

      const grid = document.getElementById('pantry-items-grid');
      if (!grid) return;
      grid.innerHTML = '';

      const q = state.searchQuery.trim().toLowerCase();
      const filtered = INGREDIENTS.filter(ing => {
        const matchCat = state.activeCategoryId === 'all' || ing.category === state.activeCategoryId;
        const matchQuery = !q || ing.name.toLowerCase().includes(q) || ing.flavorDesc.toLowerCase().includes(q);
        return matchCat && matchQuery;
      });

      if (filtered.length === 0) {
        grid.innerHTML = `<div class="col-span-full text-xs text-stone-500 italic p-3 text-center">Không tìm thấy nguyên liệu phù hợp.</div>`;
        return;
      }

      filtered.forEach(ing => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute(
          'aria-label',
          `Lấy ${ing.name}. Đặc tính vị: ${ing.flavorDesc}. ${ing.needsCooking ? 'Cần nấu chín trước khi ăn.' : 'Có thể ăn ngay hoặc chế biến.'}`
        );
        btn.className = 'p-2 rounded-xl border border-stone-200 hover:border-orange-400 bg-stone-50/70 hover:bg-orange-50/70 text-left transition flex flex-col justify-between gap-1 group';
        btn.innerHTML = `
          <div class="flex items-center justify-between w-full">
            <span class="text-xl group-hover:scale-110 transition-transform" aria-hidden="true">${ing.displayEmoji || ing.emoji}</span>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded ${
              ing.needsCooking ? 'bg-red-100 text-red-800' : 'bg-emerald-100 text-emerald-800'
            }">${ing.needsCooking ? 'Cần nấu' : 'Ăn tươi/Nấu'}</span>
          </div>
          <div class="font-bold text-xs text-stone-800 leading-snug">${ing.name}</div>
          <div class="text-[10px] text-stone-500 line-clamp-2 leading-tight">${ing.flavorDesc}</div>
        `;
        btn.addEventListener('click', () => addIngredientFromPantry(ing.id));
        grid.appendChild(btn);
      });
    }

    function renderWorkbench() {
      const stationGrid = document.getElementById('station-selector-grid');
      const activeStation = STATIONS.find(s => s.id === state.activeStationId) || STATIONS[0];

      if (stationGrid) {
        stationGrid.innerHTML = '';
        STATIONS.forEach(st => {
          const isActive = st.id === state.activeStationId;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          btn.setAttribute('aria-label', `${st.name}. ${st.desc}`);
          btn.className = `p-2 rounded-xl border text-left transition flex items-center gap-1.5 ${
            isActive
              ? 'station-btn-active font-bold'
              : 'bg-stone-50 hover:bg-amber-50 border-stone-200 text-stone-800'
          }`;
          btn.innerHTML = `
            <span class="text-lg shrink-0" aria-hidden="true">${st.emoji}</span>
            <span class="text-xs font-bold leading-tight truncate">${st.shortName}</span>
          `;
          btn.addEventListener('click', () => {
            state.activeStationId = st.id;
            playSoundEffect('pick');
            announceNVDA(
              `Đã chuyển sang dụng cụ: ${st.name}. ${st.desc} Hiện đang có ${state.stationItems.length} nguyên liệu trong dụng cụ.`,
              'polite'
            );
            renderAll();
          });
          stationGrid.appendChild(btn);
        });
      }

      document.getElementById('active-station-badge').textContent = `Đang dùng: ${activeStation.name}`;
      document.getElementById('canvas-station-overlay').textContent = `${activeStation.emoji} ${activeStation.name}`;
      document.getElementById('canvas-temp-overlay').textContent = `Nhiệt độ: ${activeStation.temp}`;
      document.getElementById('station-item-count').textContent = `${state.stationItems.length} nguyên liệu trong dụng cụ`;

      const wrapperPanel = document.getElementById('wrapper-vessel-panel');
      const wrapperList = document.getElementById('wrapper-options-list');
      const wrapperTitle = document.getElementById('wrapper-panel-title');
      const wrapperCurLabel = document.getElementById('wrapper-current-label');

      if (activeStation.isWrapperStation) {
        wrapperPanel.classList.remove('hidden');
        const curW = WRAPPERS.find(w => w.id === state.selectedWrapperId) || WRAPPERS[0];
        wrapperTitle.textContent = '🌯 Chọn Lớp Vỏ Để Cuộn Các Nguyên Liệu Bên Dưới:';
        wrapperCurLabel.textContent = curW.name;
        wrapperList.innerHTML = '';
        WRAPPERS.forEach(w => {
          const isSel = w.id === state.selectedWrapperId;
          const b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('role', 'radio');
          b.setAttribute('aria-checked', isSel ? 'true' : 'false');
          b.setAttribute('aria-label', `Vỏ cuốn ${w.name}. ${w.desc}`);
          b.className = `p-1.5 rounded-lg border text-left text-xs transition flex items-center gap-1.5 ${
            isSel ? 'bg-orange-600 text-white border-orange-700 font-bold' : 'bg-white hover:bg-orange-50 border-amber-200 text-stone-800'
          }`;
          b.innerHTML = `<span aria-hidden="true">${w.emoji}</span><span class="truncate">${w.name}</span>`;
          b.addEventListener('click', () => {
            state.selectedWrapperId = w.id;
            playSoundEffect('pick');
            announceNVDA(`Đã chọn vỏ cuốn: ${w.name} (${w.desc}). Hãy bỏ nguyên liệu vào rồi bấm Phím R để cuộn tròn một lượt!`, 'polite');
            renderWorkbench();
          });
          wrapperList.appendChild(b);
        });
      } else if (activeStation.isStuffingStation) {
        wrapperPanel.classList.remove('hidden');
        const curV = VESSELS.find(v => v.id === state.selectedVesselId) || VESSELS[0];
        wrapperTitle.textContent = '🥖 Chọn Loại Bánh / Vỏ Để Xẻ Ruột & Nhồi Nhân:';
        wrapperCurLabel.textContent = curV.name;
        wrapperList.innerHTML = '';
        VESSELS.forEach(v => {
          const isSel = v.id === state.selectedVesselId;
          const b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('role', 'radio');
          b.setAttribute('aria-checked', isSel ? 'true' : 'false');
          b.setAttribute('aria-label', `Vỏ nhồi ${v.name}. ${v.desc}`);
          b.className = `p-1.5 rounded-lg border text-left text-xs transition flex items-center gap-1.5 ${
            isSel ? 'bg-orange-600 text-white border-orange-700 font-bold' : 'bg-white hover:bg-orange-50 border-amber-200 text-stone-800'
          }`;
          b.innerHTML = `<span aria-hidden="true">${v.emoji}</span><span class="truncate">${v.name}</span>`;
          b.addEventListener('click', () => {
            state.selectedVesselId = v.id;
            playSoundEffect('pick');
            announceNVDA(`Đã chọn vỏ nhồi: ${v.name} (${v.desc}). Hãy bỏ thịt bò, xúc xích, rau sốt vào rồi bấm Phím R để nhồi và kẹp chặt!`, 'polite');
            renderWorkbench();
          });
          wrapperList.appendChild(b);
        });
      } else {
        wrapperPanel.classList.add('hidden');
      }

      const actionsContainer = document.getElementById('station-primary-actions');
      if (actionsContainer) {
        actionsContainer.innerHTML = '';
        activeStation.actions.forEach(act => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('aria-label', `${act.label}. ${act.desc}`);
          btn.className = 'py-2 px-3 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-xs sm:text-sm shadow-sm flex items-center justify-center gap-1.5 transition col-span-full sm:col-span-1';
          if (activeStation.actions.length === 1) {
            btn.className = 'py-2.5 px-4 rounded-xl bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-700 hover:to-amber-700 text-white font-extrabold text-xs sm:text-sm shadow-sm flex items-center justify-center gap-2 transition col-span-full';
          }
          btn.textContent = act.label;
          btn.addEventListener('click', () => performStationAction(act.id));
          actionsContainer.appendChild(btn);
        });
      }

      const listEl = document.getElementById('station-contents-list');
      if (listEl) {
        listEl.innerHTML = '';
        if (state.stationItems.length === 0) {
          listEl.innerHTML = `
            <div class="p-3 rounded-xl bg-stone-50 border border-dashed border-stone-300 text-xs text-stone-500 text-center">
              Chưa có nguyên liệu nào trong <strong>${activeStation.name}</strong>. Hãy bấm vào nguyên liệu bên Tủ Nguyên Liệu (Alt+2) để bỏ vào đây!
            </div>
          `;
        } else {
          state.stationItems.forEach((item, idx) => {
            const stateDesc = describeItemStateShort(item);
            const row = document.createElement('div');
            row.setAttribute('role', 'listitem');
            row.className = 'p-2 rounded-xl bg-amber-50/70 border border-amber-200/80 flex items-center justify-between gap-2 text-xs';
            row.innerHTML = `
              <div class="flex items-center gap-2 min-w-0">
                <span class="text-lg shrink-0" aria-hidden="true">${item.emoji}</span>
                <div class="min-w-0">
                  <div class="font-bold text-stone-900 truncate">${idx + 1}. ${item.name}</div>
                  <div class="text-[11px] text-stone-600 truncate">${stateDesc}</div>
                </div>
              </div>
              <div class="flex items-center gap-1 shrink-0">
                <button type="button" data-plate-idx="${idx}" class="px-2 py-1 rounded bg-emerald-100 hover:bg-emerald-200 text-emerald-900 font-bold text-[11px]" aria-label="Gắp ${item.name} (${stateDesc}) ra Đĩa Ăn">
                  Ra đĩa
                </button>
                <button type="button" data-remove-idx="${idx}" class="px-2 py-1 rounded bg-stone-200 hover:bg-red-200 text-stone-700 hover:text-red-900 font-bold text-[11px]" aria-label="Bỏ ${item.name} khỏi dụng cụ">
                  Xóa
                </button>
              </div>
            `;
            row.querySelector(`[data-plate-idx="${idx}"]`).addEventListener('click', () => {
              const [moved] = state.stationItems.splice(idx, 1);
              state.plateItems.push(moved);
              playSoundEffect('pick');
              announceNVDA(`Đã gắp ${moved.name} (${describeItemStateShort(moved)}) ra Đĩa Ăn.`, 'polite');
              renderAll();
            });
            row.querySelector(`[data-remove-idx="${idx}"]`).addEventListener('click', () => {
              const [removed] = state.stationItems.splice(idx, 1);
              announceNVDA(`Đã bỏ ${removed.name} khỏi dụng cụ.`, 'polite');
              renderAll();
            });
            listEl.appendChild(row);
          });
        }
      }
    }

    function renderSpices() {
      const grid = document.getElementById('spice-rack-grid');
      if (!grid) return;
      grid.innerHTML = '';

      SPICES.forEach(sp => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('aria-label', `Nêm ${sp.name}. ${sp.desc}`);
        btn.className = 'p-2 rounded-xl border border-stone-200 hover:border-amber-500 bg-amber-50/40 hover:bg-amber-100/70 transition flex flex-col items-center text-center gap-1 group';
        btn.innerHTML = `
          <span class="text-xl group-hover:scale-110 transition-transform" aria-hidden="true">${sp.emoji}</span>
          <span class="text-[11px] font-bold text-stone-800 leading-tight">${sp.name}</span>
        `;
        btn.addEventListener('click', () => applySpice(sp.id));
        grid.appendChild(btn);
      });
    }

    function renderPlateAndFlavorAnalysis() {
      const countBadge = document.getElementById('plate-count-badge');
      if (countBadge) {
        countBadge.textContent = `${state.plateItems.length} phần trên đĩa`;
      }

      const itemsToAnalyze = state.plateItems.length > 0 ? state.plateItems : state.stationItems;
      const isPreviewingStation = state.plateItems.length === 0 && state.stationItems.length > 0;
      const analysis = analyzeCulinaryChemistry(itemsToAnalyze);

      const dishNameEl = document.getElementById('dish-dynamic-name');
      const dishStructEl = document.getElementById('dish-structure-summary');
      const harmonyScoreEl = document.getElementById('flavor-harmony-score');

      if (dishNameEl) {
        dishNameEl.textContent = isPreviewingStation
          ? `[Đang nấu trong bếp] ${analysis.dishTitle}`
          : analysis.dishTitle;
      }
      if (dishStructEl) {
        dishStructEl.textContent = analysis.structureSummary;
      }
      if (harmonyScoreEl) {
        harmonyScoreEl.textContent = itemsToAnalyze.length > 0
          ? `Độ hài hòa: ${analysis.harmonyScore}/100`
          : 'Độ hài hòa: --';
      }

      const barsContainer = document.getElementById('flavor-bars-container');
      if (barsContainer) {
        barsContainer.innerHTML = '';
        FLAVOR_DIMENSIONS.forEach(dim => {
          const val = analysis.normalized[dim.key] || 0;
          const pct = Math.min(100, Math.round(val * 10));
          const row = document.createElement('div');
          row.className = 'text-xs';
          row.innerHTML = `
            <div class="flex items-center justify-between mb-0.5">
              <span class="font-semibold text-stone-700">${dim.label}</span>
              <span class="font-bold text-stone-900">${val.toFixed(1)} / 10</span>
            </div>
            <div class="w-full h-2 bg-stone-200 rounded-full overflow-hidden" role="progressbar" aria-label="${dim.label}" aria-valuenow="${val}" aria-valuemin="0" aria-valuemax="10">
              <div class="h-full ${dim.bg} flavor-bar-fill rounded-full" style="width: ${pct}%"></div>
            </div>
          `;
          barsContainer.appendChild(row);
        });
      }

      const tagsContainer = document.getElementById('chemistry-synergy-tags');
      if (tagsContainer) {
        tagsContainer.innerHTML = '';
        if (analysis.synergies.length === 0 && analysis.warnings.length === 0) {
          tagsContainer.innerHTML = `<span class="text-[11px] text-stone-400 italic">Hãy kết hợp nguyên liệu và gia vị để xem phản ứng hòa vị</span>`;
        } else {
          analysis.synergies.forEach(syn => {
            const span = document.createElement('span');
            span.className = 'px-2 py-1 rounded-lg bg-emerald-100 text-emerald-900 font-semibold text-[11px] leading-snug';
            span.textContent = syn;
            tagsContainer.appendChild(span);
          });
          analysis.warnings.forEach(warn => {
            const span = document.createElement('span');
            span.className = 'px-2 py-1 rounded-lg bg-red-100 text-red-900 font-semibold text-[11px] leading-snug';
            span.textContent = warn;
            tagsContainer.appendChild(span);
          });
        }
      }

      const plateList = document.getElementById('plate-contents-list');
      if (plateList) {
        plateList.innerHTML = '';
        if (state.plateItems.length === 0) {
          plateList.innerHTML = `
            <div class="p-3 rounded-xl bg-stone-50 border border-dashed border-stone-300 text-xs text-stone-500 text-center">
              Đĩa ăn đang trống. Sau khi chế biến, cuốn bánh tráng hoặc nhồi bánh mì xong, hãy bấm <strong>Bày Ra Đĩa Ăn (Phím P)</strong>!
            </div>
          `;
        } else {
          state.plateItems.forEach((item, idx) => {
            const stateDesc = describeItemStateShort(item);
            const div = document.createElement('div');
            div.setAttribute('role', 'listitem');
            div.className = 'p-2 rounded-xl bg-orange-50/70 border border-orange-200 flex items-center justify-between gap-2 text-xs';
            div.innerHTML = `
              <div class="flex items-center gap-2 min-w-0">
                <span class="text-lg shrink-0" aria-hidden="true">${item.emoji}</span>
                <div class="min-w-0">
                  <div class="font-bold text-stone-900 truncate">${idx + 1}. ${item.name}</div>
                  <div class="text-[11px] text-stone-600 truncate">${stateDesc}</div>
                </div>
              </div>
              <button type="button" data-del-plate="${idx}" class="px-2 py-1 rounded bg-stone-200 hover:bg-red-200 text-stone-700 hover:text-red-900 font-bold text-[11px] shrink-0" aria-label="Bỏ ${item.name} khỏi đĩa ăn">
                Xóa
              </button>
            `;
            div.querySelector(`[data-del-plate="${idx}"]`).addEventListener('click', () => {
              const [removed] = state.plateItems.splice(idx, 1);
              announceNVDA(`Đã bỏ ${removed.name} khỏi Đĩa Ăn.`, 'polite');
              renderAll();
            });
            plateList.appendChild(div);
          });
        }
      }
    }

    function renderAll() {
      renderCharacters();
      renderPantry();
      renderWorkbench();
      renderSpices();
      renderPlateAndFlavorAnalysis();
    }

    /*************************************************************************
     * 8. HỆ THỐNG ĐỒ HỌA CANVAS ĐỘNG (WORKBENCH + CHARACTER EXPRESSIONS)
     *************************************************************************/
    function drawWorkbenchCanvas() {
      const canvas = document.getElementById('workbench-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const W = canvas.width;
      const H = canvas.height;
      ctx.clearRect(0, 0, W, H);

      const stId = state.activeStationId;

      if (stId === 'cutting_board') {
        ctx.fillStyle = '#451a03';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#d97706';
        ctx.beginPath();
        ctx.roundRect(35, 28, W - 70, H - 48, 18);
        ctx.fill();
        ctx.strokeStyle = '#92400e';
        ctx.lineWidth = 4;
        ctx.stroke();
        ctx.strokeStyle = 'rgba(120, 53, 15, 0.22)';
        ctx.lineWidth = 2;
        for (let y = 48; y < H - 35; y += 22) {
          ctx.beginPath();
          ctx.moveTo(50, y);
          ctx.lineTo(W - 50, y);
          ctx.stroke();
        }
      } else if (stId === 'rolling_mat') {
        ctx.fillStyle = '#1c1917';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#fde68a';
        ctx.beginPath();
        ctx.roundRect(40, 26, W - 80, H - 44, 12);
        ctx.fill();
        ctx.strokeStyle = '#ca8a04';
        ctx.lineWidth = 2;
        for (let x = 52; x < W - 45; x += 14) {
          ctx.beginPath();
          ctx.moveTo(x, 28);
          ctx.lineTo(x, H - 20);
          ctx.stroke();
        }
        const wrapper = WRAPPERS.find(w => w.id === state.selectedWrapperId) || WRAPPERS[0];
        ctx.save();
        ctx.fillStyle = wrapper.id === 'rice_paper' ? 'rgba(255,255,255,0.72)' : wrapper.color;
        ctx.strokeStyle = '#78716c';
        ctx.lineWidth = 2;
        ctx.beginPath();
        if (wrapper.id === 'nori_seaweed' || wrapper.id === 'pho_sheet') {
          ctx.roundRect(130, 40, W - 260, H - 72, 8);
        } else {
          ctx.arc(W / 2, H / 2 + 4, 72, 0, Math.PI * 2);
        }
        ctx.fill();
        ctx.stroke();
        ctx.restore();
      } else if (stId === 'stuffing_station') {
        ctx.fillStyle = '#292524';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#fef3c7';
        ctx.beginPath();
        ctx.roundRect(40, 28, W - 80, H - 48, 16);
        ctx.fill();

        const vessel = VESSELS.find(v => v.id === state.selectedVesselId) || VESSELS[0];
        ctx.save();
        ctx.fillStyle = vessel.color;
        ctx.strokeStyle = '#78350f';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.ellipse(W / 2, H / 2 + 8, 145, 54, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = '#fffbeb';
        ctx.beginPath();
        ctx.ellipse(W / 2, H / 2 + 8, 120, 30, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      } else if (stId === 'frying_pan' || stId === 'deep_fryer') {
        ctx.fillStyle = '#18181b';
        ctx.fillRect(0, 0, W, H);
        const grad = ctx.createRadialGradient(W / 2, H / 2 + 8, 20, W / 2, H / 2 + 8, 115);
        grad.addColorStop(0, '#ea580c');
        grad.addColorStop(1, 'rgba(234, 88, 12, 0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(W / 2, H / 2 + 8, 115, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = stId === 'deep_fryer' ? '#ca8a04' : '#27272a';
        ctx.strokeStyle = '#52525b';
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.arc(W / 2, H / 2 + 8, 86, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      } else if (stId === 'boiling_pot') {
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#38bdf8';
        ctx.strokeStyle = '#94a3b8';
        ctx.lineWidth = 7;
        ctx.beginPath();
        ctx.arc(W / 2, H / 2 + 8, 86, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = 'rgba(255,255,255,0.65)';
        for (let i = 0; i < 8; i++) {
          const bx = W / 2 + Math.cos(state.animTick * 0.05 + i) * 48;
          const by = H / 2 + 8 + Math.sin(state.animTick * 0.07 + i * 2) * 42;
          const br = 4 + (i % 4) * 2;
          ctx.beginPath();
          ctx.arc(bx, by, br, 0, Math.PI * 2);
          ctx.fill();
        }
      } else if (stId === 'oven' || stId === 'charcoal_grill') {
        ctx.fillStyle = '#1c1917';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = stId === 'charcoal_grill' ? '#7f1d1d' : '#431407';
        ctx.beginPath();
        ctx.roundRect(55, 32, W - 110, H - 52, 14);
        ctx.fill();
        ctx.strokeStyle = '#a8a29e';
        ctx.lineWidth = 3;
        for (let x = 75; x < W - 70; x += 24) {
          ctx.beginPath();
          ctx.moveTo(x, 34);
          ctx.lineTo(x, H - 22);
          ctx.stroke();
        }
      } else if (stId === 'blender') {
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = 'rgba(224, 242, 254, 0.25)';
        ctx.strokeStyle = '#bae6fd';
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.roundRect(W / 2 - 75, 26, 150, H - 46, 18);
        ctx.fill();
        ctx.stroke();
      }

      const count = state.stationItems.length;
      if (count === 0) {
        ctx.fillStyle = 'rgba(255,255,255,0.85)';
        ctx.font = '600 13px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Chưa có nguyên liệu — Hãy chọn từ Tủ Nguyên Liệu (Alt+2)', W / 2, H / 2 + 12);
      } else {
        state.stationItems.forEach((item, idx) => {
          const angle = (idx / Math.max(1, count)) * Math.PI * 2 + (state.stationActionFlash > 0 ? state.animTick * 0.15 : 0);
          const radius = count === 1 ? 0 : Math.min(58, 22 + count * 6);
          const cx = W / 2 + Math.cos(angle) * radius;
          const cy = H / 2 + 8 + Math.sin(angle) * (radius * 0.6);

          ctx.save();
          let fillCol = item.cookLevel === 0 ? item.color : item.cookedColor;
          if (item.cookLevel >= 3) fillCol = '#1c1917';
          ctx.fillStyle = fillCol;
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 2.5;

          ctx.beginPath();
          if (item.kind === 'rolled') {
            ctx.roundRect(cx - 44, cy - 18, 88, 36, 16);
          } else if (item.kind === 'stuffed') {
            ctx.ellipse(cx, cy, 48, 24, 0, 0, Math.PI * 2);
          } else {
            ctx.arc(cx, cy, item.cutState === 'minced' ? 16 : 22, 0, Math.PI * 2);
          }
          ctx.fill();
          ctx.stroke();

          ctx.font = '20px sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(item.emoji, cx, cy - 2);

          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 10px Inter, sans-serif';
          ctx.fillText(item.name.slice(0, 16), cx, cy + 26);
          ctx.restore();
        });
      }

      if (state.stationActionFlash > 0) {
        state.stationActionFlash--;
        ctx.save();
        for (let i = 0; i < 10; i++) {
          const px = W / 2 + (Math.random() - 0.5) * 160;
          const py = H / 2 + (Math.random() - 0.5) * 90;
          ctx.fillStyle = state.stationActionType === 'spice' ? '#fde047' : '#fb923c';
          ctx.beginPath();
          ctx.arc(px, py, 3 + Math.random() * 4, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }
    }

    function drawCharacterCanvas() {
      const canvas = document.getElementById('character-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const W = canvas.width;
      const H = canvas.height;
      ctx.clearRect(0, 0, W, H);

      const char = CHARACTERS.find(c => c.id === state.activeCharacterId) || CHARACTERS[0];
      if (state.charAnimTimer > 0) {
        state.charAnimTimer--;
      } else if (state.charAnimState !== 'idle') {
        state.charAnimState = 'idle';
      }

      const bounce = Math.sin(state.animTick * 0.08) * 3;
      const cx = W / 2;
      const cy = H / 2 + 6 + bounce;

      ctx.save();
      let auraColor = 'rgba(251, 191, 36, 0.2)';
      if (state.charAnimState === 'love') auraColor = 'rgba(16, 185, 129, 0.35)';
      else if (state.charAnimState === 'spicy') auraColor = 'rgba(239, 68, 68, 0.45)';
      else if (state.charAnimState === 'sour') auraColor = 'rgba(132, 204, 22, 0.4)';
      else if (state.charAnimState === 'yuck') auraColor = 'rgba(120, 113, 108, 0.45)';

      ctx.fillStyle = auraColor;
      ctx.beginPath();
      ctx.arc(cx, cy, 62, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = state.charAnimState === 'spicy'
        ? '#ef4444'
        : state.charAnimState === 'yuck'
        ? '#84cc16'
        : char.color;
      ctx.strokeStyle = '#1c1917';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(cx, cy, 46, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(cx - 16, cy - 10, 9, 0, Math.PI * 2);
      ctx.arc(cx + 16, cy - 10, 9, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#1c1917';
      if (state.charAnimState === 'sour') {
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(cx - 22, cy - 15);
        ctx.lineTo(cx - 12, cy - 10);
        ctx.lineTo(cx - 22, cy - 5);
        ctx.moveTo(cx + 22, cy - 15);
        ctx.lineTo(cx + 12, cy - 10);
        ctx.lineTo(cx + 22, cy - 5);
        ctx.stroke();
      } else {
        ctx.beginPath();
        ctx.arc(cx - 16, cy - 10, 4.5, 0, Math.PI * 2);
        ctx.arc(cx + 16, cy - 10, 4.5, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.strokeStyle = '#1c1917';
      ctx.lineWidth = 3;
      ctx.beginPath();
      const hasFoodWaiting = state.plateItems.length > 0;
      if (state.charAnimState === 'love' || state.charAnimState === 'good') {
        ctx.fillStyle = '#991b1b';
        ctx.arc(cx, cy + 12, 16, 0, Math.PI);
        ctx.fill();
        ctx.stroke();
      } else if (state.charAnimState === 'spicy') {
        ctx.fillStyle = '#f97316';
        ctx.arc(cx, cy + 16, 14, 0, Math.PI * 2);
        ctx.fill();
        ctx.font = '22px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('🔥', cx, cy + 36);
      } else if (state.charAnimState === 'sour') {
        ctx.moveTo(cx - 8, cy + 15);
        ctx.lineTo(cx + 8, cy + 15);
        ctx.stroke();
      } else if (state.charAnimState === 'yuck' || state.charAnimState === 'salty') {
        ctx.arc(cx, cy + 24, 14, Math.PI, 0);
        ctx.stroke();
      } else if (hasFoodWaiting) {
        ctx.fillStyle = '#7f1d1d';
        ctx.ellipse(cx, cy + 15, 15, 12 + Math.sin(state.animTick * 0.15) * 3, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      } else {
        ctx.arc(cx, cy + 10, 12, 0.15 * Math.PI, 0.85 * Math.PI);
        ctx.stroke();
      }

      ctx.font = '24px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(char.emoji, cx, cy - 42);
      ctx.restore();
    }

    function startAnimationLoop() {
      function frame() {
        state.animTick++;
        drawWorkbenchCanvas();
        drawCharacterCanvas();
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    /*************************************************************************
     * 9. SỰ KIỆN NÚT BẤM & PHÍM TẮT TOÀN CỤC CHO NVDA
     *************************************************************************/
    function bindEvents() {
      const btnDestStation = document.getElementById('btn-dest-station');
      const btnDestPlate = document.getElementById('btn-dest-plate');

      btnDestStation.addEventListener('click', () => {
        state.ingredientDestination = 'station';
        btnDestStation.setAttribute('aria-pressed', 'true');
        btnDestPlate.setAttribute('aria-pressed', 'false');
        btnDestStation.className = 'py-1.5 px-2 rounded-lg text-xs font-bold bg-orange-600 text-white shadow-sm transition';
        btnDestPlate.className = 'py-1.5 px-2 rounded-lg text-xs font-bold bg-transparent text-stone-700 hover:bg-white/60 transition';
        announceNVDA('Đã chọn chế độ: Bỏ nguyên liệu từ tủ vào Dụng Cụ Đang Chọn.', 'polite');
      });

      btnDestPlate.addEventListener('click', () => {
        state.ingredientDestination = 'plate';
        btnDestPlate.setAttribute('aria-pressed', 'true');
        btnDestStation.setAttribute('aria-pressed', 'false');
        btnDestPlate.className = 'py-1.5 px-2 rounded-lg text-xs font-bold bg-emerald-600 text-white shadow-sm transition';
        btnDestStation.className = 'py-1.5 px-2 rounded-lg text-xs font-bold bg-transparent text-stone-700 hover:bg-white/60 transition';
        announceNVDA('Đã chọn chế độ: Bỏ nguyên liệu từ tủ thẳng lên Đĩa Ăn.', 'polite');
      });

      const btnSpiceStation = document.getElementById('btn-spice-target-station');
      const btnSpicePlate = document.getElementById('btn-spice-target-plate');

      btnSpiceStation.addEventListener('click', () => {
        state.spiceTarget = 'station';
        btnSpiceStation.setAttribute('aria-pressed', 'true');
        btnSpicePlate.setAttribute('aria-pressed', 'false');
        btnSpiceStation.className = 'px-2 py-1 rounded text-[11px] font-bold bg-amber-600 text-white';
        btnSpicePlate.className = 'px-2 py-1 rounded text-[11px] font-bold text-stone-700 hover:bg-white';
        announceNVDA('Đã chọn nêm gia vị vào Dụng Cụ Chế Biến.', 'polite');
      });

      btnSpicePlate.addEventListener('click', () => {
        state.spiceTarget = 'plate';
        btnSpicePlate.setAttribute('aria-pressed', 'true');
        btnSpiceStation.setAttribute('aria-pressed', 'false');
        btnSpicePlate.className = 'px-2 py-1 rounded text-[11px] font-bold bg-amber-600 text-white';
        btnSpiceStation.className = 'px-2 py-1 rounded text-[11px] font-bold text-stone-700 hover:bg-white';
        announceNVDA('Đã chọn nêm gia vị trực tiếp lên Đĩa Ăn.', 'polite');
      });

      const searchInput = document.getElementById('input-search-ingredient');
      searchInput.addEventListener('input', (e) => {
        state.searchQuery = e.target.value || '';
        renderPantry();
      });

      document.getElementById('btn-move-station-to-plate').addEventListener('click', moveStationToPlate);
      document.getElementById('btn-clear-station').addEventListener('click', () => {
        if (state.stationItems.length === 0) {
          announceNVDA('Dụng cụ đã trống sẵn rồi.', 'polite');
          return;
        }
        state.stationItems = [];
        announceNVDA('Đã dọn sạch nguyên liệu trong dụng cụ hiện tại.', 'polite');
        renderAll();
      });

      document.getElementById('btn-feed-character').addEventListener('click', feedCharacter);
      document.getElementById('btn-plate-to-station').addEventListener('click', movePlateBackToStation);
      document.getElementById('btn-clear-plate').addEventListener('click', () => {
        if (state.plateItems.length === 0) {
          announceNVDA('Đĩa ăn đã trống sẵn rồi.', 'polite');
          return;
        }
        state.plateItems = [];
        announceNVDA('Đã đổ sạch đĩa thức ăn để làm món mới.', 'polite');
        renderAll();
      });

      // Drink water button for character
      document.getElementById('btn-drink-water').addEventListener('click', () => {
        const char = CHARACTERS.find(c => c.id === state.activeCharacterId) || CHARACTERS[0];
        playSoundEffect('drink');
        state.charAnimState = 'good';
        state.charAnimTimer = 50;
        const msg = `${char.name} vừa uống một ly nước lọc mát lạnh: "Ực ực... Khà! Đã khát quá, lưỡi hết cay và hết mặn rồi, sẵn sàng thưởng thức món tiếp theo của đầu bếp!"`;
        document.getElementById('char-mood-tag').textContent = 'Sảng khoái 💧😋';
        document.getElementById('char-reaction-speech').textContent = msg;
        announceNVDA(msg, 'polite');
      });

      // Craving hint button (optional inspiration)
      document.getElementById('btn-craving-hint').addEventListener('click', () => {
        const char = CHARACTERS.find(c => c.id === state.activeCharacterId) || CHARACTERS[0];
        const hint = char.cravings[state.cravingIndex % char.cravings.length];
        state.cravingIndex++;
        playSoundEffect('pick');
        document.getElementById('char-reaction-speech').textContent = `"${hint}"`;
        announceNVDA(`Gợi ý món ${char.name} đang thèm (tùy chọn): ${hint}`, 'polite');
      });

      document.getElementById('btn-read-dish-summary').addEventListener('click', readCurrentDishAndFlavorReport);

      const btnSfx = document.getElementById('btn-toggle-sfx');
      btnSfx.addEventListener('click', () => {
        state.sfxEnabled = !state.sfxEnabled;
        btnSfx.setAttribute('aria-pressed', state.sfxEnabled ? 'true' : 'false');
        document.getElementById('icon-sfx').textContent = state.sfxEnabled ? '🔊' : '🔇';
        document.getElementById('label-sfx').textContent = `Âm thanh Bếp: ${state.sfxEnabled ? 'BẬT' : 'TẮT'}`;
        if (state.sfxEnabled) playSoundEffect('pick');
        announceNVDA(`Đã ${state.sfxEnabled ? 'bật' : 'tắt'} hiệu ứng âm thanh nhà bếp.`, 'polite');
      });

      const btnTts = document.getElementById('btn-toggle-tts');
      btnTts.addEventListener('click', () => {
        state.ttsEnabled = !state.ttsEnabled;
        btnTts.setAttribute('aria-pressed', state.ttsEnabled ? 'true' : 'false');
        document.getElementById('label-tts').textContent = state.ttsEnabled
          ? 'Giọng đọc Web: BẬT'
          : 'Giọng đọc Web: TẮT (Dùng NVDA)';
        announceNVDA(
          state.ttsEnabled
            ? 'Đã bật giọng đọc trình duyệt tự động.'
            : 'Đã tắt giọng đọc trình duyệt để ưu tiên trình đọc màn hình NVDA của bạn.',
          'polite'
        );
      });

      document.getElementById('btn-clear-log').addEventListener('click', () => {
        document.getElementById('nvda-history-log').innerHTML = '';
        announceNVDA('Đã xóa nhật ký hoạt động.', 'polite');
      });

      const modalHelp = document.getElementById('modal-help');
      const btnOpenHelp = document.getElementById('btn-open-help');
      const btnCloseHelp = document.getElementById('btn-close-help');

      btnOpenHelp.addEventListener('click', () => {
        modalHelp.classList.remove('hidden');
        modalHelp.classList.add('flex');
        btnCloseHelp.focus();
      });

      btnCloseHelp.addEventListener('click', () => {
        modalHelp.classList.add('hidden');
        modalHelp.classList.remove('flex');
        btnOpenHelp.focus();
      });

      window.addEventListener('keydown', (e) => {
        const tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : '';
        const isTyping = tag === 'input' || tag === 'textarea';

        if (e.key === 'Escape' && !modalHelp.classList.contains('hidden')) {
          modalHelp.classList.add('hidden');
          modalHelp.classList.remove('flex');
          btnOpenHelp.focus();
          return;
        }

        if (e.altKey && !e.ctrlKey && !e.shiftKey) {
          const regionMap = {
            '1': { id: 'region-characters', name: 'Khu vực 1: Chọn Thực Khách' },
            '2': { id: 'region-pantry', name: 'Khu vực 2: Tủ Nguyên Liệu' },
            '3': { id: 'region-workbench', name: 'Khu vực 3: Bàn Chế Biến & 9 Dụng Cụ' },
            '4': { id: 'region-spices', name: 'Khu vực 4: Khay Gia Vị Mở Rộng' },
            '5': { id: 'region-plate', name: 'Khu vực 5: Đĩa Thức Ăn & Hòa Vị' },
            '6': { id: 'btn-feed-character', name: 'Nút Đút Cho Nhân Vật Ăn' }
          };
          if (regionMap[e.key]) {
            e.preventDefault();
            const el = document.getElementById(regionMap[e.key].id);
            if (el) {
              el.focus();
              announceNVDA(`Đã nhảy tới ${regionMap[e.key].name}.`, 'polite');
            }
            return;
          }
        }

        if (isTyping) return;

        const keyLower = e.key.toLowerCase();
        if (keyLower === 'i') {
          e.preventDefault();
          readCurrentDishAndFlavorReport();
        } else if (keyLower === 'p') {
          e.preventDefault();
          moveStationToPlate();
        } else if (keyLower === 'f') {
          e.preventDefault();
          feedCharacter();
        } else if (keyLower === 'r') {
          e.preventDefault();
          const st = STATIONS.find(s => s.id === state.activeStationId);
          if (st && st.isWrapperStation) {
            performStationAction('roll_tight');
          } else if (st && st.isStuffingStation) {
            performStationAction('stuff_pack');
          } else {
            announceNVDA('Phím R dùng khi bạn đang ở Bàn Cuốn Đa Năng hoặc Trạm Kẹp & Nhồi Bánh Mì. Hãy chọn dụng cụ số 2 hoặc số 3 để cuốn hoặc nhồi!', 'polite');
          }
        } else if (keyLower === 'c') {
          e.preventDefault();
          const st = STATIONS.find(s => s.id === state.activeStationId);
          if (st && st.actions.length > 0) {
            performStationAction(st.actions[0].id);
          }
        } else if (keyLower === 'h') {
          e.preventDefault();
          modalHelp.classList.remove('hidden');
          modalHelp.classList.add('flex');
          btnCloseHelp.focus();
        }
      });
    }

    window.addEventListener('load', () => {
      bindEvents();
      renderAll();
      startAnimationLoop();
    });
  </script>
</body>
</html>